{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "graph",
      "title": "Backend Uptime (seconds)",
      "targets": [
        {
          "expr": "chatterbate_uptime_seconds",
          "legendFormat": "{{service}}",
          "interval": ""
        }
      ],
      "id": 1
    },
    {
      "type": "graph",
      "title": "Node Memory Usage (bytes)",
      "targets": [
        {
          "expr": "chatterbate_memory_rss_bytes",
          "legendFormat": "RSS {{service}}"
        },
        {
          "expr": "chatterbate_memory_heap_used_bytes",
          "legendFormat": "Heap {{service}}"
        }
      ],
      "id": 2
    },
    {
      "type": "gauge",
      "title": "Data Integrity",
      "targets": [
        {
          "expr": "chatterbate_data_ok"
        }
      ],
      "id": 3,
      "options": {
        "min": 0,
        "max": 1
      }
    },
    {
      "type": "graph",
      "title": "Problem Count",
      "targets": [
        {
          "expr": "chatterbate_problem_count",
          "legendFormat": "{{service}}"
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "Backend Up",
      "targets": [
        {
          "expr": "chatterbate_up"
        }
      ],
      "id": 5
    }
  ],
  "schemaVersion": 36,
  "version": 1,
  "title": "Chatterbate Backend Overview"
}
